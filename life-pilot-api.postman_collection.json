{
  "info": {
    "_postman_id": "ea149d0d-8644-4e0d-8416-8d435b8b2f3b",
    "name": "Life Pilot API",
    "description": "Import this collection into Postman. Set email and password collection variables, then run Register or Login. Login automatically saves the returned token to accessToken. Requests marked Public do not require a token; all other requests are protected.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "accessToken", "value": "" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "expenseId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "noteId", "value": "" },
    { "key": "expenseDate", "value": "" }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Health check",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/health" }
        },
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.token) pm.collectionVariables.set('accessToken', data.token);"], "type": "text/javascript" } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Your name\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "pm.test('Login returns a token', () => pm.expect(data.token).to.be.a('string').and.not.empty);", "if (data.token) pm.collectionVariables.set('accessToken', data.token);"], "type": "text/javascript" } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Request password recovery",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" },
            "url": "{{baseUrl}}/account/password-recovery"
          }
        }
      ]
    },
    {
      "name": "Authentication and account (protected)",
      "item": [
        { "name": "Current user", "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" } },
        { "name": "Logout", "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" } },
        { "name": "Get profile", "request": { "method": "GET", "url": "{{baseUrl}}/account/profile" } },
        {
          "name": "Save profile",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Your name\",\n  \"phone\": \"\",\n  \"location\": \"\",\n  \"role\": \"\",\n  \"bio\": \"\",\n  \"imageUrl\": \"\"\n}" },
            "url": "{{baseUrl}}/account/profile"
          }
        }
      ]
    },
    {
      "name": "Life OS state (protected)",
      "item": [
        { "name": "Get complete state", "request": { "method": "GET", "url": "{{baseUrl}}/life-os/state" } },
        {
          "name": "Replace complete state",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"categories\": [],\n  \"expenses\": [],\n  \"tasks\": [],\n  \"timerSessions\": [],\n  \"notes\": [],\n  \"settings\": {\n    \"profileName\": \"\",\n    \"profileEmail\": \"\",\n    \"profilePhone\": \"\",\n    \"profileLocation\": \"\",\n    \"profileRole\": \"\",\n    \"profileBio\": \"\",\n    \"profileImage\": \"\",\n    \"currency\": \"BDT\",\n    \"notificationEnabled\": false,\n    \"quietHoursStart\": \"22:00\",\n    \"quietHoursEnd\": \"07:00\",\n    \"aiProvider\": \"off\"\n  }\n}" },
            "url": "{{baseUrl}}/life-os/state"
          }
        },
        { "name": "Reset my state to empty", "request": { "method": "POST", "url": "{{baseUrl}}/life-os/reset" } }
      ]
    },
    {
      "name": "Categories (protected)",
      "item": [
        { "name": "List categories", "request": { "method": "GET", "url": "{{baseUrl}}/life-os/categories" } },
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"New category\",\n  \"type\": \"monthly\",\n  \"monthlyLimit\": 0,\n  \"color\": \"teal\",\n  \"isActive\": true\n}" },
            "url": "{{baseUrl}}/life-os/categories"
          }
        },
        {
          "name": "Update category",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated category\",\n  \"monthlyLimit\": 0\n}" }, "url": "{{baseUrl}}/life-os/categories/{{categoryId}}" }
        },
        {
          "name": "Update monthly limit",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"monthlyLimit\": 0\n}" }, "url": "{{baseUrl}}/life-os/categories/{{categoryId}}/limit" }
        },
        { "name": "Delete category", "request": { "method": "DELETE", "url": "{{baseUrl}}/life-os/categories/{{categoryId}}" } }
      ]
    },
    {
      "name": "Expenses (protected)",
      "item": [
        { "name": "List expenses", "request": { "method": "GET", "url": "{{baseUrl}}/life-os/expenses" } },
        {
          "name": "Create expense",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"date\": \"{{expenseDate}}\",\n  \"itemName\": \"New item\",\n  \"category\": \"Uncategorized\",\n  \"amount\": 0,\n  \"quantity\": 1,\n  \"sourceType\": \"manual\"\n}" }, "url": "{{baseUrl}}/life-os/expenses" }
        },
        {
          "name": "Create expenses in bulk",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"date\": \"{{expenseDate}}\",\n  \"rows\": [\n    { \"itemName\": \"New item\", \"category\": \"Uncategorized\", \"amount\": 0, \"quantity\": 1 }\n  ]\n}" }, "url": "{{baseUrl}}/life-os/expenses/bulk" }
        },
        { "name": "Delete expense", "request": { "method": "DELETE", "url": "{{baseUrl}}/life-os/expenses/{{expenseId}}" } }
      ]
    },
    {
      "name": "Tasks (protected)",
      "item": [
        { "name": "List tasks", "request": { "method": "GET", "url": "{{baseUrl}}/life-os/tasks" } },
        {
          "name": "Create task",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"New task\",\n  \"category\": \"General\",\n  \"priority\": \"medium\",\n  \"plannedStart\": \"09:00\",\n  \"plannedEnd\": \"10:00\",\n  \"status\": \"pending\",\n  \"repeatRule\": \"once\",\n  \"alertEnabled\": false\n}" }, "url": "{{baseUrl}}/life-os/tasks" }
        },
        {
          "name": "Reorder tasks",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"orderedTaskIds\": [\"{{taskId}}\"]\n}" }, "url": "{{baseUrl}}/life-os/tasks/reorder" }
        },
        {
          "name": "Update task",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated task\"\n}" }, "url": "{{baseUrl}}/life-os/tasks/{{taskId}}" }
        },
        {
          "name": "Update task status",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"completed\"\n}" }, "url": "{{baseUrl}}/life-os/tasks/{{taskId}}/status" }
        },
        { "name": "Delete task", "request": { "method": "DELETE", "url": "{{baseUrl}}/life-os/tasks/{{taskId}}" } }
      ]
    },
    {
      "name": "Timer sessions (protected)",
      "item": [
        { "name": "List timer sessions", "request": { "method": "GET", "url": "{{baseUrl}}/life-os/timer-sessions" } },
        {
          "name": "Create timer session",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"New session\",\n  \"category\": \"General\",\n  \"durationSeconds\": 60,\n  \"mode\": \"stopwatch\"\n}" }, "url": "{{baseUrl}}/life-os/timer-sessions" }
        }
      ]
    },
    {
      "name": "Notes (protected)",
      "item": [
        { "name": "List notes", "request": { "method": "GET", "url": "{{baseUrl}}/life-os/notes" } },
        {
          "name": "Create note",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"New note\",\n  \"body\": \"\",\n  \"tags\": []\n}" }, "url": "{{baseUrl}}/life-os/notes" }
        },
        {
          "name": "Update note",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated note\",\n  \"body\": \"\",\n  \"tags\": []\n}" }, "url": "{{baseUrl}}/life-os/notes/{{noteId}}" }
        },
        { "name": "Delete note", "request": { "method": "DELETE", "url": "{{baseUrl}}/life-os/notes/{{noteId}}" } }
      ]
    },
    {
      "name": "Settings and diagnostics (protected)",
      "item": [
        { "name": "Get settings", "request": { "method": "GET", "url": "{{baseUrl}}/life-os/settings" } },
        {
          "name": "Update settings",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"currency\": \"BDT\",\n  \"notificationEnabled\": false,\n  \"quietHoursStart\": \"22:00\",\n  \"quietHoursEnd\": \"07:00\",\n  \"aiProvider\": \"off\"\n}" }, "url": "{{baseUrl}}/life-os/settings" }
        },
        { "name": "Database health", "request": { "method": "GET", "url": "{{baseUrl}}/health/db" } }
      ]
    }
  ]
}
